#Parameters file

[mesh]
minlevel = 5					#max mesh refinement level
maxlevel = 7					#min mesh refinement level 
mesh_shape = 1					#1 for "stretched" mesh, 0 for cubic mesh
[../]

[model]
linear_solver = 1				#1 for linearized model
bc_type = 1;					#boundary conditions: 1 for Dirichlet, 0 for Neumann
decay = -1.5					#decay parameter for Blobby surface
molecular_dielectric_constant = 2		#molecular relative dielectric constant 
solvent_dielectric_constant = 80		#solvent relative dielectric constant
ionic_strength = 0.145				#ionic strength expressend in molar concentration
[../]

[surface]
#surface_type = 1				#surface type: ses=0, skin=1, blobby=2
surface_parameter = 0.45			#skin surface parameter for skin type or probe radius for ses 
stern_layer_thickness = 2.			#stern layer thickness
number_of_threads = 1				#number of threads used by nanoshaper
[../]

[algorithm]
linear_solver = lis				#mumps = direct solver, lis = iterative solver
solver_options = cg				#cg = conjugate gradient 
preconditioner = ilu 				#jacobi, ilu, ... (none if no preconditioner is required)
preconditioner_options = 0			#fill level for ilu
tol = 1.0e-12					#tolerance 
[../]

[output]
p4estfilename = poisson_boltzmann_p4est	#file name for p4forest output
markerfilename = poisson_boltzmann_marker_0	#file name for marker output
lsfilename = poisson_boltzmann_levelset_0	#file name for levelset surface output
nsfilename = poisson_boltzmann_nanoshaper_0	#file name for nanoshaper surface output
[../]
